<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F4EA"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 顶部栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnAdvExit"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="← 退出"
            android:textColor="#2F6B4F"
            android:textSize="13sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="⚔️ 冒险小剧场"
            android:textColor="#233128"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAdvHp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="史莱姆 3/3"
            android:textColor="#6D28D9"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 双方生命值对比栏：左侧小伙伴元气心，右侧史莱姆体力 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPetHp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💖💖💖 小伙伴元气 3/3"
                android:textColor="#2F6B4F"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/pbPetHp"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="3dp"
                android:max="3"
                android:progress="3"
                android:progressTint="#E05A7A" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSlimeHpBarLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="👾 拖延史莱姆 3/3"
                android:textColor="#4C1D95"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/pbMonsterHp"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="3dp"
                android:max="3"
                android:progress="3"
                android:progressTint="#7B2CBF" />
        </LinearLayout>
    </LinearLayout>

    <!-- 在线题库年龄与难度选择栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvQuizLevelInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🌐 7岁 · 在线题库"
            android:textColor="#475569"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnDiffEasy"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:minWidth="0dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="0dp"
            android:text="简单"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnDiffNormal"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:minWidth="0dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="0dp"
            android:text="适中"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnDiffHard"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:minWidth="0dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="0dp"
            android:text="挑战"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 战斗舞台 -->
    <com.growthbuddy.child.BattleStageView
        android:id="@+id/advBattleStage"
        android:layout_width="match_parent"
        android:layout_height="148dp"
        android:layout_marginTop="8dp"
        android:background="#FFFDF9" />

    <!-- 史莱姆泡泡蓄力 / 答题速度条 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvSlimeCharge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚡ 8秒内答对触发闪电暴击 · 史莱姆缓慢蓄力中"
            android:textColor="#4C1D95"
            android:textSize="11.5sp" />

        <ProgressBar
            android:id="@+id/pbSlimeCharge"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="112dp"
            android:layout_height="7dp"
            android:layout_marginStart="8dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#7B2CBF" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvAdvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="答对题目给小伙伴充能，击败史莱姆拖延怪！"
        android:textColor="#2F6B4F"
        android:textSize="13.5sp"
        android:textStyle="bold" />

    <!-- 答题充能卡片 -->
    <LinearLayout
        android:id="@+id/quizCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:background="#FFFDF9"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvQuizCat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#E8F2EC"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="数学"
            android:textColor="#2F6B4F"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvQuizQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="题目加载中..."
            android:textColor="#233128"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnOpt0"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="12dp"
            android:gravity="start|center_vertical"
            android:text="A."
            android:textColor="#233128"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnOpt1"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="8dp"
            android:gravity="start|center_vertical"
            android:text="B."
            android:textColor="#233128"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnOpt2"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginTop="8dp"
            android:gravity="start|center_vertical"
            android:text="C."
            android:textColor="#233128"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnAdvNextRound"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#E69A2B"
            android:text="🎉 再来一关！"
            android:textColor="#FFFFFF"
            android:textSize="15.5sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
