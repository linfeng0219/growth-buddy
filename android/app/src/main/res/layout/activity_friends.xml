<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF6EE"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- 顶部栏 -->
    <LinearLayout
        android:id="@+id/friendsTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnFriendsBack"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="0dp"
            android:singleLine="true"
            android:text="← 返回"
            android:textColor="#2F6B4F"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/tvFriendsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="💬 消息"
            android:textColor="#233128"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAddFriend"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="#E8913A"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="0dp"
            android:singleLine="true"
            android:text="➕ 加好友"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/friendsLoading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="6dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <!-- 主内容区（手机/竖屏单栏；平板横屏左联系人+申请 / 右即时聊天窗口） -->
    <LinearLayout
        android:id="@+id/friendsBodySplit"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/friendsSwipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        <ScrollView
            android:id="@+id/friendsListScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/friendsLeftListWrap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="18dp">

                <!-- 新的好友申请容器（无申请时隐藏） -->
                <LinearLayout
                    android:id="@+id/requestsSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvRequestsTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔔 新的好友申请（需要你同意）"
                        android:textColor="#B8621B"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/requestsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <!-- 折叠分组列表容器（点击分类名展开/收起） -->
                <LinearLayout
                    android:id="@+id/friendsListContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- 右侧/子页内容窗格（平板横屏右侧显示；手机竖屏点信箱文件夹时展开显示） -->
        <FrameLayout
            android:id="@+id/friendsChatPaneWrap"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_card"
            android:padding="10dp"
            android:visibility="gone">

            <include
                android:id="@+id/friendsChatPane"
                layout="@layout/view_chat_pane"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:id="@+id/friendsMailBox"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingBottom="8dp">

                    <Button
                        android:id="@+id/btnMailFolderBack"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="6dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="0dp"
                        android:singleLine="true"
                        android:text="← 消息"
                        android:textColor="#2F6B4F"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvMailFolderTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="📥 收件箱"
                        android:textColor="#233128"
                        android:textSize="15.5sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnMailPaneWrite"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:backgroundTint="#E8913A"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="0dp"
                        android:singleLine="true"
                        android:text="✉️ 写信"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <include
                    android:id="@+id/friendsMailPane"
                    layout="@layout/view_mailbox_pane"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSplitChatPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="24dp"
                android:text="👈 请在左侧点击好友、群聊或信箱文件夹"
                android:textColor="#8A7E6E"
                android:textSize="15sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
