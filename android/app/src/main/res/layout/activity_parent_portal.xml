<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F2EA"
    android:orientation="vertical">

    <!-- 原生家长管理台顶部工具栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFDF9"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/tvParentHeaderName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="👨‍👩‍👧 家长管理台"
            android:textColor="#233128"
            android:textSize="15.5sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnParentRefresh"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:paddingHorizontal="10dp"
            android:text="↻ 刷新"
            android:textColor="#2F6B4F"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnParentSwitchAccount"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:minWidth="0dp"
            android:paddingHorizontal="10dp"
            android:text="🔄 切换账号"
            android:textColor="#B8621B"
            android:textSize="12sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/parentWebLoading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <WebView
        android:id="@+id/webParentPortal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
