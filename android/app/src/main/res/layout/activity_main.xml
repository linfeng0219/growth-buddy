<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF6EE">

    <!-- ==================== 1. 原生儿童登录页（无需家庭码） ==================== -->
    <ScrollView
        android:id="@+id/loginContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="GROWTH BUDDY · 家庭成长助手"
                    android:textColor="#8A7E6E"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnLoginUpdate"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="🔄 更新"
                    android:textColor="#2F6B4F"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.growthbuddy.child.PetStageView
                android:id="@+id/loginPetPreview"
                android:layout_width="210dp"
                android:layout_height="175dp"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="成长小伙伴"
                android:textColor="#2B2620"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="18dp"
                android:gravity="center"
                android:text="输入孩子或家长账号和密码，自动识别身份，\n已登录过的账号可在下方直接下拉切换哦！"
                android:textColor="#6B6052"
                android:textSize="13.5sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- 已记住账号与头像下拉切换器 -->
                <LinearLayout
                    android:id="@+id/layoutSavedAccountPicker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:visibility="gone">

                    <com.growthbuddy.child.SpeciesThumbView
                        android:id="@+id/ivLoginSavedAvatar"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="10dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvLoginSavedName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="快速选择已记住账号"
                            android:textColor="#233128"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvLoginSavedSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@username"
                            android:textColor="#6B6052"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▾ 选择账号"
                        android:textColor="#2F6B4F"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="登录账号（孩子 / 家长通用）"
                    android:textColor="#5C5347"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etLoginUser"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="12dp"
                    android:background="@android:drawable/edit_text"
                    android:hint="例如：dabao01 或 mama01"
                    android:imeOptions="actionNext"
                    android:inputType="textNoSuggestions"
                    android:paddingHorizontal="12dp"
                    android:singleLine="true"
                    android:textColor="#2B2620"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="登录密码"
                    android:textColor="#5C5347"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etLoginPass"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="14dp"
                    android:background="@android:drawable/edit_text"
                    android:hint="请输入你的密码"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:paddingHorizontal="12dp"
                    android:singleLine="true"
                    android:textColor="#2B2620"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnDoLogin"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:backgroundTint="#E8913A"
                    android:text="登录进入 →"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLoginMsg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:textColor="#C94A38"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvServerFooter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="当前服务器：https://linuu.xyz"
                android:textColor="#9A8E7D"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <!-- ==================== 2. 原生主界面 ==================== -->
    <LinearLayout
        android:id="@+id/appContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- 顶部工具栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFDF9"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <LinearLayout
                android:id="@+id/avatarChip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="2dp">

                <com.growthbuddy.child.SpeciesThumbView
                    android:id="@+id/ivHeaderAvatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="9dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvKidBanner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="成长小伙伴"
                        android:textColor="#2B2620"
                        android:textSize="15.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvFamilySub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="点击头像可更换 ✎"
                        android:textColor="#8A7E6E"
                        android:textSize="11.5sp" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnBoostVolMain"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#FBE9D0"
                android:minWidth="0dp"
                android:paddingHorizontal="8dp"
                android:text="🔊 音量+"
                android:textColor="#B86511"
                android:textSize="11.5sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnMute"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="0dp"
                android:paddingHorizontal="8dp"
                android:text="🔊"
                android:textColor="#2F6B4F"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnAppUpdate"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="0dp"
                android:paddingHorizontal="6dp"
                android:text="更新"
                android:textColor="#2F6B4F"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnRefresh"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="0dp"
                android:paddingHorizontal="6dp"
                android:text="刷新"
                android:textColor="#2F6B4F"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnLogout"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:minWidth="0dp"
                android:paddingHorizontal="8dp"
                android:text="退出"
                android:textColor="#9B5642"
                android:textSize="12.5sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/topLoading"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <!-- 中央滚动内容区 -->
        <ScrollView
            android:id="@+id/mainScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- ===== TAB 1: 我的小伙伴 & 打卡 ===== -->
                <LinearLayout
                    android:id="@+id/homeSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 宠物舞台卡片 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvStagePill"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_pill"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp"
                                android:text="Lv.1 一颗蛋"
                                android:textColor="#2F6B4F"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvStreakPill"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_pill"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp"
                                android:text="🌟 连续 0 天"
                                android:textColor="#B86511"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <com.growthbuddy.child.PetStageView
                            android:id="@+id/petStageView"
                            android:layout_width="match_parent"
                            android:layout_height="220dp"
                            android:layout_marginTop="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="👆 点一点宠物摸摸头，听听它对你说什么"
                            android:textColor="#9A8E7D"
                            android:textSize="11.5sp" />

                        <!-- 对话气泡 + 朗读按钮 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvBubble"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/bg_card"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="10dp"
                                android:text="抱抱我，完成一件小事我就会慢慢破壳哦。"
                                android:textColor="#4B4339"
                                android:textSize="13.5sp" />

                            <Button
                                android:id="@+id/btnSpeak"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_marginStart="8dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minWidth="0dp"
                                android:padding="0dp"
                                android:text="🔊"
                                android:textSize="16sp" />
                        </LinearLayout>

                        <!-- 宠物名字 + 改名 -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvPetName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="我的小伙伴"
                                android:textColor="#2B2620"
                                android:textSize="19sp"
                                android:textStyle="bold" />

                            <Button
                                android:id="@+id/btnRenamePet"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:text="✏️ 改名"
                                android:textColor="#8A7E6E"
                                android:textSize="12.5sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvStatsRow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="陪伴 0 天 · 今日 0/0 · 领养蛋 0 枚"
                            android:textColor="#7D7263"
                            android:textSize="12.5sp" />

                        <!-- XP 进度条 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tvXpLeft"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="成长值 0"
                                    android:textColor="#6B6052"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/tvXpRight"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="距离下一阶还差 10"
                                    android:textColor="#6B6052"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <ProgressBar
                                android:id="@+id/xpProgress"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="12dp"
                                android:layout_marginTop="5dp"
                                android:max="100"
                                android:progress="0"
                                android:progressTint="#E8913A" />
                        </LinearLayout>

                        <!-- 近 7 天圆点 -->
                        <LinearLayout
                            android:id="@+id/weekStrip"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:orientation="horizontal" />

                        <Button
                            android:id="@+id/btnFreeFocus"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="12dp"
                            android:text="⏱️ 自由专注（番茄时钟）"
                            android:textColor="#2F6B4F"
                            android:textSize="13.5sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnToggleBattle"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_weight="1"
                                android:minWidth="0dp"
                                android:paddingHorizontal="8dp"
                                android:text="⚔️ 冒险小剧场"
                                android:textColor="#2F6B4F"
                                android:textSize="13sp" />

                            <Button
                                android:id="@+id/btnOpenMailbox"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:minWidth="0dp"
                                android:paddingHorizontal="8dp"
                                android:text="📬 家长信箱"
                                android:textColor="#2F6B4F"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/battleBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="#F7F2E7"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:visibility="gone">

                            <com.growthbuddy.child.BattleStageView
                                android:id="@+id/battleStageView"
                                android:layout_width="match_parent"
                                android:layout_height="136dp" />

                            <Button
                                android:id="@+id/btnRunBattle"
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:layout_marginTop="6dp"
                                android:backgroundTint="#E69A2B"
                                android:text="出猎一击！"
                                android:textColor="#FFFFFF"
                                android:textSize="13.5sp" />

                            <TextView
                                android:id="@+id/tvBattleMsg"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:gravity="center"
                                android:textColor="#2F6B4F"
                                android:textSize="12.5sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 今日专属任务卡片 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="我的今日专属任务"
                                android:textColor="#2B2620"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvTodayBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_pill"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="3dp"
                                android:text="0/0"
                                android:textColor="#2F6B4F"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/tasksContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="vertical" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="end"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnUndo"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="38dp"
                                android:text="↩ 撤销刚才那一次"
                                android:textColor="#6B6052"
                                android:textSize="12.5sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- ===== TAB 2: 伙伴图鉴 & 拍立得纪念墙 ===== -->
                <LinearLayout
                    android:id="@+id/dexSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- 领养蛋金卡 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvCouponTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="当前拥有领养蛋：0 枚"
                            android:textColor="#9A5B13"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="10dp"
                            android:gravity="center"
                            android:text="领养蛋由家长确认积分后发放 · 成年体(120成长值)可开神秘蛋"
                            android:textColor="#8A7E6E"
                            android:textSize="12sp" />

                        <Button
                            android:id="@+id/btnMysteryEgg"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:backgroundTint="#E8913A"
                            android:text="🥚 开一枚神秘蛋（随机孵化未拥有伙伴）"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- 图鉴网格容器 -->
                    <LinearLayout
                        android:id="@+id/dexContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical" />

                    <!-- 拍立得纪念墙 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="拍立得纪念墙"
                                android:textColor="#2B2620"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvWallCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 张合影"
                                android:textColor="#8A7E6E"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/avatarPickRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal" />

                        <EditText
                            android:id="@+id/etSnapNote"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="8dp"
                            android:background="@android:drawable/edit_text"
                            android:hint="写一句今天的合影心情（可选）"
                            android:maxLength="16"
                            android:paddingHorizontal="10dp"
                            android:singleLine="true"
                            android:textSize="14sp" />

                        <Button
                            android:id="@+id/btnSnap"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="8dp"
                            android:backgroundTint="#2F6B4F"
                            android:text="📷 拍一张今日合影（每天一张）"
                            android:textColor="#FFFFFF" />

                        <LinearLayout
                            android:id="@+id/wallContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- 底部双 Tab 切换栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#FFFDF9"
            android:elevation="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/tabHome"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="🐾 我的小伙伴"
                android:textColor="#2F6B4F"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <View
                android:layout_width="1dp"
                android:layout_height="28dp"
                android:layout_gravity="center_vertical"
                android:background="#EAE2D3" />

            <Button
                android:id="@+id/tabDex"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="📖 图鉴与纪念"
                android:textColor="#8A7E6E"
                android:textSize="14.5sp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
